def _bloc_python(mid, port):
return textwrap.dedent(f'''
# ============================================================
# MODULE {mid:04d} — Route API Python
# ============================================================
class Module{mid:04d}:
"""Module {mid} — gestion de route API"""
VERSION = "{VERSION}"
PORT = {port}
def __init__(self):
self.id = {mid}
self.name = "module_{mid:04d}"
self.cache = {{}}
self.stats = {{"appels": 0, "erreurs": 0, "succes": 0}}
