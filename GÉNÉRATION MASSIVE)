class Handler(BaseHTTPRequestHandler):
rbufsize = BUFFER_SIZE
wbufsize = BUFFER_SIZE
def log_message(self, *a): pass
def _send(self, code, body, ctype="application/json"):
try:
if isinstance(body, str): body = body.encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", ctype + "; charset=utf-8")
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Content-Length", str(len(body)))
self.send_header("X-Buffer-Size", str(BUFFER_SIZE))
self.end_headers()
for i in range(0, len(body), BUFFER_SIZE):
self.wfile.write(body[i:i+BUFFER_SIZE])
self.wfile.flush()
except (BrokenPipeError, ConnectionResetError): pass
def _read_json(self):
try:
n = int(self.headers.get("Content-Length", "0"))
if n > BUFFER_SIZE:
chunks = []
remaining = n
while remaining > 0:
chunk = self.rfile.read(min(BUFFER_SIZE, remaining))
if not chunk: break
chunks.append(chunk); remaining -= len(chunk)
raw = b"".join(chunks)
else: raw = self.rfile.read(n)
return json.loads(raw.decode("utf-8"))
except: return {}
def do_GET(self):
p = self.path.split("?")[0]
qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
if p in ("/", "/index.html"):
html = (HTML_UI.replace("__V__", VERSION)
.replace("__LANG__", str(len(LANGAGES_SUPPORTES)))
.replace("__EXT__", str(TOTAL_EXTENSIONS))
.replace("__API__", str(len(APIS)))
.replace("__NICHE__", str(len(NICHES)))
.replace("__GEN__", str(len(GENERATEURS)))
.replace("__MASSIF__", str(len(BLOCS)))
.replace("__AUTEUR__", AUTEUR)
.replace("__LIC__", LICENCE)
.replace("__PORT__", str(PORT)))
return self._send(200, html, "text/html")
if p == "/api/health":
return self._send(200, json.dumps({
"ok": True, "version": VERSION, "port": PORT,
"buffer_size": BUFFER_SIZE, "langages": len(LANGAGES_SUPPORTES),
"apis": list(APIS.keys()), "massif_langs": list(BLOCS.keys()),
"min_lignes": MIN_LIGNES, "max_lignes": MAX_LIGNES,
}))
if p == "/api/buffer":
return self._send(200, json.dumps({
"buffer_size": BUFFER_SIZE, "rbufsize": self.rbufsize,
"wbufsize": self.wbufsize, "port": PORT,
"min_lignes": MIN_LIGNES, "max_lignes": MAX_LIGNES,
}))
if p == "/api/languages":
return self._send(200, json.dumps(tool_list_languages(), ensure_ascii=False))
if p == "/api/tools":
return self._send(200, json.dumps({"tools": [
{"name": "list_languages", "endpoint": "/api/languages"},
{"name": "parse_spec", "endpoint": "/api/parse-spec"},
{"name": "validate_spec", "endpoint": "/api/validate-spec"},
{"name": "get_generation_context", "endpoint": "/api/generation-context"},
{"name": "get_project_structure", "endpoint": "/api/project-structure"},
{"name": "ensure_parity", "endpoint": "/api/ensure-parity"},
{"name": "import_spec_from_github", "endpoint": "/api/import-github"},
{"name": "import_spec_from_source", "endpoint": "/api/import-source"},
], "count": 8}))
if p == "/api/search":
q = qs.get("q", [""])[0]
if not q: return self._send(400, json.dumps({"error": "q manquant"}))
return self._send(200, json.dumps({"query": q, "results": search_all_apis(q)}, ensure_ascii=False, default=str))
if p == "/api/enrich":
q = qs.get("q", [""])[0]
if not q: return self._send(400, json.dumps({"error": "q manquant"}))
return self._send(200, json.dumps({"query": q, "added": enrichir_kb(q), "kb_size": KB.size()}))
return self._send(404, json.dumps({"error": "not found"}))
def do_POST(self):
p = self.path.split("?")[0]
data = self._read_json()

# ⚡ ENDPOINT MASSIF
if p == "/api/generate-massif":
prompt = data.get("prompt", "").strip()
langage = data.get("langage", "python").lower()
port = int(data.get("port", 3001))
lignes = int(data.get("lignes", DEFAULT_LIGNES))

if not prompt: return self._send(400, json.dumps({"error": "prompt manquant"}))
if langage not in BLOCS: return self._send(400, json.dumps({"error": f"langage massif non supporté: {langage}"}))

# Validation de la cible
lignes = max(MIN_LIGNES, min(MAX_LIGNES, lignes))

t0 = time.time()
code = generer_massif(prompt, langage, port, lignes)
dur = round(time.time() - t0, 3)
nb_lignes = code.count("\n") + 1
nb_modules = code.count("MODULE ") or code.count("class Module")

return self._send(200, json.dumps({
"ok": True, "langage": langage, "port": port,
"code": code, "lignes": nb_lignes, "cible": lignes,
"octets": len(code.encode()), "modules": nb_modules,
"duration_s": dur, "buffer": BUFFER_SIZE,
}, ensure_ascii=False))

if p == "/api/generate":
prompt = data.get("prompt", "").strip()
langage = data.get("langage", "python").lower()
port = int(data.get("port", 3001))
if not prompt: return self._send(400, json.dumps({"error": "prompt manquant"}))
code = generer_script(prompt, langage, port)
return self._send(200, json.dumps({"ok": True, "langage": langage, "port": port, "code": code, "lignes": code.count("\n")}, ensure_ascii=False))
if p == "/api/analyze-code":
code = data.get("code", "")
langage = data.get("langage", "python")
if not code: return self._send(400, json.dumps({"error": "code manquant"}))
return self._send(200, json.dumps(analyser_code(code, langage), ensure_ascii=False))
if p == "/api/parse-spec":
return self._send(200, json.dumps(tool_parse_spec(data.get("spec", "")), ensure_ascii=False))
if p == "/api/validate-spec":
return self._send(200, json.dumps(tool_validate_spec(data.get("spec", {})), ensure_ascii=False))
if p == "/api/generation-context":
return self._send(200, json.dumps(tool_get_generation_context(data.get("spec", {}), data.get("langage", "python")), ensure_ascii=False))
if p == "/api/project-structure":
return self._send(200, json.dumps(tool_get_project_structure(data.get("langage", "python")), ensure_ascii=False))
if p == "/api/ensure-parity":
return self._send(200, json.dumps(tool_ensure_parity(data.get("code1", ""), data.get("code2", ""), data.get("langage", "python")), ensure_ascii=False))
if p == "/api/import-github":
return self._send(200, json.dumps(tool_import_spec_from_github(data.get("url", "")), ensure_ascii=False))
if p == "/api/import-source":
return self._send(200, json.dumps(tool_import_spec_from_source(data.get("path", "")), ensure_ascii=False))
return self._send(404, json.dumps({"error": "not found"}))

class Server(ThreadingMixIn, HTTPServer):
daemon_threads = True
allow_reuse_address = True
request_queue_size = 1000

