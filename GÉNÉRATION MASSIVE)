results = []
if d.get("AbstractText"):
results.append({"title": d.get("Heading", ""), "snippet": d.get("AbstractText", "")[:400]})
for topic in d.get("RelatedTopics", [])[:limit]:
if isinstance(topic, dict) and "Text" in topic:
results.append({"title": topic.get("Text", "")[:100]})
return results[:limit]

def search_all_apis(query, max_workers=20):
results = {}
with ThreadPoolExecutor(max_workers=max_workers) as ex:
futures = {ex.submit(fn, query, 3): name for name, fn in APIS.items()}
for fut in as_completed(futures):
name = futures[fut]
try: results[name] = fut.result(timeout=15)
except Exception as e: results[name] = {"error": str(e)[:120]}
return results

