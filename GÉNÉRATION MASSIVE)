bloc_fn = BLOCS.get(langage, BLOCS["python"])
header = _header(langage, prompt, port, cible_lignes)
corps = []
lignes_actuelles = header.count("\n")
module_id = 1
max_modules = 5000 # Sécurité

# ⚡ BOUCLE MAÎTRESSE : empile jusqu'à cible
while lignes_actuelles < cible_lignes and module_id <= max_modules:
bloc = bloc_fn(module_id, port)
corps.append(bloc)
