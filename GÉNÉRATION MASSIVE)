def tool_parse_spec(spec_markdown):
if not spec_markdown: return {"ok": False, "error": "spec vide"}
lines = spec_markdown.split("\n")
spec = {"title": "", "languages": [], "requirements": [], "constraints": []}
current = None
for line in lines:
stripped = line.strip()
if line.startswith("# ") and not spec["title"]:
spec["title"] = line[2:].strip()
elif line.startswith("## "):
current = line[3:].strip().lower()
elif stripped.startswith("- ") or stripped.startswith("* "):
item = stripped[2:].strip()
if not item: continue
if current and "lang" in current: spec["languages"].append(item.lower())
elif current and "requis" in current: spec["requirements"].append(item)
elif current and "contrainte" in current: spec["constraints"].append(item)
return {"ok": True, "spec": spec}

def tool_validate_spec(spec):
if not spec: return {"ok": False, "valid": False, "error": "spec vide"}
errors, warnings = [], []
if not spec.get("title"): errors.append("Titre manquant")
if not spec.get("requirements"): warnings.append("Aucune exigence")
return {"ok": True, "valid": len(errors) == 0, "errors": errors, "warnings": warnings}

